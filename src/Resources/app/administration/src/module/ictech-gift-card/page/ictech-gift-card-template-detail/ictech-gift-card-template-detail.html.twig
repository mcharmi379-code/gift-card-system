{% block ictech_gift_card_template_detail %}
<sw-page class="ictech-gift-card-template-detail">

    <template #smart-bar-header>
        <h2>
            <span v-if="isCreateMode">{{ $tc('ictech-gift-card.template.detail.titleCreate') }}</span>
            <span v-else>{{ identifier }}</span>
        </h2>
    </template>

    <template #language-switch>
        <sw-language-switch
            :save-changes-function="saveOnLanguageChange"
            :abort-change-function="abortOnLanguageChange"
            :disabled="isCreateMode || isLoading"
            @on-change="onChangeLanguage"
        />
    </template>

    <template #smart-bar-actions>
        <sw-button
            v-tooltip.bottom="tooltipCancel"
            :disabled="isLoading || undefined"
            @click="onCancel"
        >
            {{ $tc('global.default.cancel') }}
        </sw-button>

        <sw-button-process
            v-model:process-success="isSaveSuccessful"
            v-tooltip.bottom="tooltipSave"
            variant="primary"
            :is-loading="isLoading"
            :disabled="isLoading || !acl.can('ictech_gift_card.editor') || undefined"
            @update:process-success="saveFinish"
            @click.prevent="onSave"
        >
            {{ $tc('global.default.save') }}
        </sw-button-process>
    </template>

    <template #content>
        <sw-card-view>
            <sw-card
                v-if="templateEntity"
                position-identifier="ictech-gift-card-template-detail-main"
                :title="$tc('ictech-gift-card.template.detail.cardTitle')"
                :is-loading="isLoading"
            >
                <sw-tabs
                    position-identifier="ictech-gift-card-template-detail-tabs"
                    :default-item="activeTab"
                    @new-item-active="activeTab = $event.name"
                >
                    <sw-tabs-item name="information">
                        {{ $tc('ictech-gift-card.template.detail.tabInformation') }}
                    </sw-tabs-item>
                    <sw-tabs-item name="customize">
                        {{ $tc('ictech-gift-card.template.detail.tabCustomize') }}
                    </sw-tabs-item>
                </sw-tabs>

                <div
                    v-if="activeTab === 'information'"
                    class="ictech-gift-card-template-detail__tab-content"
                >
                    <sw-container columns="minmax(0, 1fr) 360px" gap="32px">
                        <div>
                            <sw-text-field
                                v-model:value="templateEntity.name"
                                :label="$tc('ictech-gift-card.template.detail.labelName')"
                                :placeholder="$tc('ictech-gift-card.template.detail.placeholderName')"
                                name="name"
                                required
                                validation="required"
                                :error="templateEntityNameError"
                                :disabled="!acl.can('ictech_gift_card.editor') || undefined"
                            />

                            <sw-text-field
                                v-model:value="templateEntity.tag"
                                :label="$tc('ictech-gift-card.template.detail.labelTag')"
                                :placeholder="$tc('ictech-gift-card.template.detail.placeholderTag')"
                                name="tag"
                                :disabled="!acl.can('ictech_gift_card.editor') || undefined"
                            />

                            <sw-switch-field
                                v-model:value="templateEntity.active"
                                :label="$tc('ictech-gift-card.template.detail.labelActive')"
                                name="active"
                                bordered
                                :disabled="!acl.can('ictech_gift_card.editor') || undefined"
                            />
                        </div>

                        <div>
                            <sw-upload-listener
                                :upload-tag="mediaUploadTag"
                                auto-upload
                                @media-upload-finish="setMediaItem"
                            />
                            <sw-media-upload-v2
                                class="ictech-gift-card-template-detail__media-upload"
                                :source="templateEntity.mediaId"
                                :allow-multi-select="false"
                                variant="regular"
                                :upload-tag="mediaUploadTag"
                                :label="$tc('ictech-gift-card.template.detail.labelImage')"
                                default-folder="ictech_gift_card_template"
                                file-accept="image/*"
                                :disabled="!acl.can('ictech_gift_card.editor') || undefined"
                                @sw-media-upload-v2-media-upload-success="setMediaItem"
                                @media-drop="onDropMedia"
                                @media-upload-sidebar-open="openMediaSidebar"
                                @media-upload-remove-image="onUnlinkMedia"
                            />
                        </div>
                    </sw-container>
                </div>

                <div
                    v-else
                    class="ictech-gift-card-template-detail__customize"
                >
                    <div class="ictech-gift-card-template-detail__preview">
                        <div
                            class="ictech-gift-card-template-detail__preview-canvas"
                            :style="previewStyle"
                        >
                            <img
                                v-if="previewImageUrl"
                                class="ictech-gift-card-template-detail__preview-image"
                                :src="previewImageUrl"
                                :alt="templateEntity.name || ''"
                            >
                            <div
                                v-else
                                class="ictech-gift-card-template-detail__preview-empty"
                            >
                                <sw-icon name="regular-image" size="48" />
                            </div>
                            <div class="ictech-gift-card-template-detail__preview-overlay">
                                <div
                                    class="ictech-gift-card-template-detail__preview-headline"
                                    :style="{ color: customize.colorOne }"
                                >
                                    <strong>{{ customize.textTwo }}</strong>
                                    <strong>{{ customize.textThree }}</strong>
                                </div>
                                <span
                                    class="ictech-gift-card-template-detail__preview-brand"
                                    :style="{ color: customize.colorOne }"
                                >
                                    {{ customize.textOne }}
                                </span>
                                <em
                                    class="ictech-gift-card-template-detail__preview-code"
                                    :style="{ color: customize.colorOne }"
                                >
                                    {{ customize.discountCode }}
                                </em>
                                <b
                                    class="ictech-gift-card-template-detail__preview-price"
                                    :style="{ color: customize.colorOne }"
                                >
                                    {{ customize.price }}
                                </b>
                            </div>
                        </div>
                    </div>

                    <div class="ictech-gift-card-template-detail__controls">
                        <sw-card
                            position-identifier="ictech-gift-card-template-detail-data"
                            :title="$tc('ictech-gift-card.template.detail.cardDataVariables')"
                        >
                            <sw-text-field
                                v-model:value="customize.price"
                                :label="$tc('ictech-gift-card.template.detail.labelPrice')"
                            />
                            <sw-text-field
                                v-model:value="customize.discountCode"
                                :label="$tc('ictech-gift-card.template.detail.labelDiscountCode')"
                            />
                        </sw-card>

                        <sw-card
                            position-identifier="ictech-gift-card-template-detail-text"
                            :title="$tc('ictech-gift-card.template.detail.cardCustomText')"
                        >
                            <sw-text-field v-model:value="customize.textOne" label="var_text1" />
                            <sw-text-field v-model:value="customize.textTwo" label="var_text2" />
                            <sw-text-field v-model:value="customize.textThree" label="var_text3" />
                        </sw-card>

                        <sw-card
                            position-identifier="ictech-gift-card-template-detail-color"
                            :title="$tc('ictech-gift-card.template.detail.cardCustomColor')"
                        >
                            <sw-colorpicker
                                v-model:value="customize.colorOne"
                                label="var_color1"
                            />
                            <sw-switch-field
                                v-model:value="customize.pdfOnly"
                                :label="$tc('ictech-gift-card.template.detail.labelPdfOnly')"
                                bordered
                            />
                        </sw-card>
                    </div>
                </div>
            </sw-card>
        </sw-card-view>
    </template>

    <template #sidebar>
        <sw-sidebar :propagate-width="true">
            <sw-sidebar-media-item
                ref="mediaSidebarItem"
                :disabled="!acl.can('ictech_gift_card.editor') || undefined"
            >
                <template #context-menu-items="media">
                    <sw-context-menu-item @click="setMediaFromSidebar(media.mediaItem)">
                        {{ $tc('ictech-gift-card.template.detail.labelUseImage') }}
                    </sw-context-menu-item>
                </template>
            </sw-sidebar-media-item>
        </sw-sidebar>
    </template>
</sw-page>
{% endblock %}
