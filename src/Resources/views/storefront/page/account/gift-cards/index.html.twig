{% sw_extends '@Storefront/storefront/page/account/_page.html.twig' %}

{% block page_account_main_content %}
    {% block page_account_gift_cards_title %}
        <div class="account-welcome">
            <h1 class="account-welcome-title">
                {{ 'ictech-gift-card.account.pageTitle'|trans|sw_sanitize }}
            </h1>
        </div>
    {% endblock %}

    {% block page_account_gift_cards_content %}
        {% if vouchers|length > 0 %}
            <div class="table-responsive">
                <table class="table gift-card-list">
                    <thead>
                        <tr>
                            <th>{{ 'ictech-gift-card.account.columnCode'|trans|sw_sanitize }}</th>
                            <th>{{ 'ictech-gift-card.account.columnRecipient'|trans|sw_sanitize }}</th>
                            <th>{{ 'ictech-gift-card.account.columnOriginalAmount'|trans|sw_sanitize }}</th>
                            <th>{{ 'ictech-gift-card.account.columnRemainingBalance'|trans|sw_sanitize }}</th>
                            <th>{{ 'ictech-gift-card.account.columnStatus'|trans|sw_sanitize }}</th>
                            <th>{{ 'ictech-gift-card.account.columnExpiresAt'|trans|sw_sanitize }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for voucher in vouchers %}
                            {% block page_account_gift_card_row %}
                                <tr>
                                    <td>
                                        <span class="gift-card-code">{{ voucher.code }}</span>
                                    </td>
                                    <td>{{ voucher.recipientName }}</td>
                                    <td>{{ voucher.originalAmount|currency }}</td>
                                    <td>{{ voucher.remainingBalance|currency }}</td>
                                    <td>
                                        <span class="badge gift-card-status gift-card-status--{{ voucher.status.value }}">
                                            {{ ('ictech-gift-card.status.' ~ voucher.status.value)|trans|sw_sanitize }}
                                        </span>
                                    </td>
                                    <td>{{ voucher.expiresAt|format_date('short') }}</td>
                                </tr>
                            {% endblock %}
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            {% block page_account_gift_cards_empty %}
                <div class="alert alert-info">
                    {{ 'ictech-gift-card.account.noGiftCards'|trans|sw_sanitize }}
                </div>
            {% endblock %}
        {% endif %}
    {% endblock %}
{% endblock %}
