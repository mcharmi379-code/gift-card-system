{% sw_extends '@Storefront/storefront/page/account/_page.html.twig' %}

{% block page_account_main_content %}
    {% block page_account_gift_cards_title %}
        <div class="account-welcome">
            <h1 class="account-welcome-title">
                {{ 'ictech-gift-card.account.pageTitle'|trans|sw_sanitize }}
            </h1>
        </div>
    {% endblock %}

    {% block page_account_gift_cards_content %}
        {% if vouchers.total > 0 %}
            <div class="table-responsive">
                <table class="table gift-card-list">
                    <thead>
                        <tr>
                            <th>{{ 'ictech-gift-card.account.columnCode'|trans|sw_sanitize }}</th>
                            <th>{{ 'ictech-gift-card.account.columnRecipient'|trans|sw_sanitize }}</th>
                            <th>{{ 'ictech-gift-card.account.columnRecipientEmail'|trans|sw_sanitize }}</th>
                            <th>{{ 'ictech-gift-card.account.columnOriginalAmount'|trans|sw_sanitize }}</th>
                            <th>{{ 'ictech-gift-card.account.columnRemainingBalance'|trans|sw_sanitize }}</th>
                            <th>{{ 'ictech-gift-card.account.columnStatus'|trans|sw_sanitize }}</th>
                            <th>{{ 'ictech-gift-card.account.columnExpiresAt'|trans|sw_sanitize }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for voucher in vouchers %}
                            {% block page_account_gift_card_row %}
                                <tr>
                                    <td>
                                        <span class="gift-card-code">{{ voucher.code }}</span>
                                    </td>
                                    <td>{{ voucher.recipientName }}</td>
                                    <td>
                                        {% if voucher.customFields.deliveryMethod is defined %}
                                            {% if voucher.customFields.deliveryMethod is same as('print') %}
                                                -
                                            {% else %}
                                                {{ voucher.recipientEmail }}
                                            {% endif %}
                                        {% else %}
                                            {{ voucher.recipientEmail }}
                                        {% endif %}
                                    </td>
                                    <td>{{ voucher.originalAmount|currency }}</td>
                                    <td>{{ voucher.remainingBalance|currency }}</td>
                                    <td>
                                        {% set isExpired = false %}
                                        {% if voucher.expiresAt and voucher.expiresAt < date() and voucher.status.value is same as('unused') %}
                                            {% set isExpired = true %}
                                        {% endif %}

                                        {% if isExpired %}
                                            <span class="badge gift-card-status gift-card-status--expired">
                                                {{ 'ictech-gift-card.status.expired'|trans|sw_sanitize }}
                                            </span>
                                        {% else %}
                                            <span class="badge gift-card-status gift-card-status--{{ voucher.status.value }}">
                                                {{ ('ictech-gift-card.status.' ~ voucher.status.value)|trans|sw_sanitize }}
                                            </span>
                                        {% endif %}
                                    </td>
                                    <td>{{ voucher.expiresAt|format_date('short') }}</td>
                                </tr>
                            {% endblock %}
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {% set totalPages = (vouchers.total / (vouchers.limit ?: 1))|round(0, 'ceil') %}
            {% if totalPages > 1 %}
                <div class="account-gift-cards-pagination mt-3">
                    <form class="account-gift-cards-pagination-form"
                          action="{{ path('frontend.ictech.gift_card.account.page') }}"
                          method="get"
                          onchange="this.submit()">
                        {% sw_include '@Storefront/storefront/component/pagination.html.twig' with {
                            entities: vouchers,
                            criteria: vouchers.criteria
                        } %}
                    </form>
                </div>
            {% endif %}
        {% else %}
            {% block page_account_gift_cards_empty %}
                {% sw_include '@Storefront/storefront/utilities/alert.html.twig' with {
                    type: 'warning',
                    content: 'ictech-gift-card.account.noGiftCards'|trans|sw_sanitize
                } %}
            {% endblock %}
        {% endif %}
    {% endblock %}
{% endblock %}
