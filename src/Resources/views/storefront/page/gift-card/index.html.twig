{% sw_extends '@Storefront/storefront/base.html.twig' %}

{% block base_content %}
    {% set defaultAmount = giftCardDefaultAmount %}

    <div class="ictech-gift-card-page" data-ictech-gift-card-page>
        {% block ictech_gift_card_page_header %}
            <h1 class="ictech-gift-card-page__title">{{ 'ictech-gift-card.page.title'|trans }}</h1>
            <div class="ictech-gift-card-page__intro">
                {{ 'ictech-gift-card.page.intro'|trans }}
            </div>
        {% endblock %}

        <form
            action="{{ path('frontend.checkout.line-item.add') }}"
            method="post"
            class="ictech-gift-card-form"
            data-add-to-cart="true"
            data-form-validation="true"
        >
            {% block ictech_gift_card_form_hidden_inputs %}
                <input type="hidden" name="redirectTo" value="frontend.cart.offcanvas">
                <input type="hidden" name="lineItems[gift-card][id]" value="{{ defaultAmount.productId ?? '' }}" data-gift-card-line-item-input="id" data-gift-card-product-id>
                <input type="hidden" name="lineItems[gift-card][referencedId]" value="{{ defaultAmount.productId ?? '' }}" data-gift-card-line-item-input="referencedId" data-gift-card-referenced-id>
                <input type="hidden" name="lineItems[gift-card][type]" value="product" data-gift-card-line-item-input="type">
                <input type="hidden" name="lineItems[gift-card][stackable]" value="1" data-gift-card-line-item-input="stackable">
                <input type="hidden" name="lineItems[gift-card][removable]" value="1" data-gift-card-line-item-input="removable">
                <input type="hidden" name="lineItems[gift-card][quantity]" value="1" data-gift-card-line-item-input="quantity">

                <input type="hidden" name="lineItems[gift-card][payload]" data-gift-card-line-item-input="payload" data-gift-card-payload value="{}">
                <input type="hidden" name="giftCardTemplateId" data-gift-card-template-id value="">
            {% endblock %}

            {% block ictech_gift_card_form_delivery %}
                {% sw_include '@ICTECHGiftCard/storefront/page/gift-card/delivery.html.twig' %}
            {% endblock %}

            {% block ictech_gift_card_form_templates %}
                {% sw_include '@ICTECHGiftCard/storefront/page/gift-card/templates.html.twig' %}
            {% endblock %}

            {% block ictech_gift_card_form_info %}
                {% sw_include '@ICTECHGiftCard/storefront/page/gift-card/info.html.twig' %}
            {% endblock %}
        </form>
    </div>
{% endblock %}
